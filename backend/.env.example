# chain / RPC
MANTLE_NETWORK=testnet                              
MANTLE_WS_URL=wss://rpc.testnet.mantle.xyz         
MANTLE_HTTP_URL=https://rpc.testnet.mantle.xyz    

# storage
DATABASE_URL=postgresql+asyncpg://mantis:mantis@localhost:5432/Zeham

# Nansen 
NANSEN_API_KEY=your_nansen_key_here
NANSEN_BASE_URL=https://api.nansen.ai/v1

# logging
LOG_LEVEL=INFO
LOG_JSON=true                                      

# watch auth (leave empty to keep /watch open in dev)
WATCH_API_KEY=

# enrichment scheduler
ENRICH_INTERVAL_SECONDS=30
ENRICH_BATCH_SIZE=50
NANSEN_CACHE_TTL_SECONDS=300

# listener tuning
MAX_CONCURRENT_HANDLERS=20
BACKFILL_ON_RECONNECT=true
RECONNECT_MAX_RETRIES=5
RECONNECT_BASE_DELAY=2.0
RECONNECT_MAX_DELAY=60.0

# detection cycle
DETECTION_ENABLED=true
DETECTION_INTERVAL_SECONDS=60
DETECTION_MAX_EVENTS_PER_BATCH=50
AI_TIMEOUT_SECONDS=15.0                             

# AI providers (Leave a key empty to disable that provider)
ELFA_API_KEY=
ELFA_BASE_URL=https://api.elfa.ai/v1
ELFA_MODEL=elfa-security-v1
ALTLLM_API_KEY=
ALTLLM_BASE_URL=https://api.altllm.com/v1
ALTLLM_MODEL=altclaw-v1

AGENT_PRIVATE_KEY=
ERC8004_CONTRACT_ADDRESS=                           
ERC8004_ABI_PATH=abis/MantisAgentIdentity.json     
ERC8004_GAS_LIMIT=200000
ERC8004_NETWORK=testnet                            

BROADCASTER_ENABLED=true
BROADCASTER_INTERVAL_SECONDS=10                     
BROADCASTER_BATCH_SIZE=50
DEDUP_WINDOW_MINUTES=10                             
DIGEST_INTERVAL_MINUTES=10                          

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS_ENABLED=true                      

# Discord
DISCORD_WEBHOOK_URL=                               

# Mantle explorer 
MANTLE_EXPLORER_BASE=https://explorer.sepolia.mantle.xyz
# MANTLE_EXPLORER_BASE=https://explorer.mantle.xyz   # mainnet 
MANTLE_EXPLORER_API_KEY=    

# Base URL the Telegram /watch handler uses to call this service's own /watch API.
SELF_API_BASE=http://localhost:8000
